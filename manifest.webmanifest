{
  "name": "편한 EPUB 리더",
  "short_name": "EPUB 리더",
  "description": "휴대폰과 컴퓨터에서 EPUB 전자책을 편하게 읽는 앱",
  "lang": "ko",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f3f8",
  "theme_color": "#2b2540",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [ { "name": "book", "accept": ["application/epub+zip", ".epub"] } ] }
  },
  "file_handlers": [
    { "action": "./", "accept": { "application/epub+zip": [".epub"] } }
  ]
}
